# Deny by default. Only reviewed public paths are allowed.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/pyproject.toml
!/AGENTS.md
!/CHANGELOG.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/version.yml
!/src/
/src/*
!/src/glareshield/
/src/glareshield/*
!/src/glareshield/__init__.py
!/src/glareshield/model.py
!/src/glareshield/config.py
!/src/glareshield/colors.py
!/src/glareshield/effects.py
!/src/glareshield/engine.py
!/src/glareshield/cli.py
!/src/glareshield/app.py
!/src/glareshield/runtime.py
!/src/glareshield/web.py
!/src/glareshield/setup.py
!/src/glareshield/discovery.py
!/src/glareshield/simulator.py
!/src/glareshield/audio.py
!/src/glareshield/keyboard.py
!/src/glareshield/sounds.py
!/src/glareshield/static/
/src/glareshield/static/*
!/src/glareshield/static/index.html
!/src/glareshield/drivers/
/src/glareshield/drivers/*
!/src/glareshield/drivers/__init__.py
!/src/glareshield/drivers/base.py
!/src/glareshield/drivers/mock.py
!/src/glareshield/drivers/hue.py
!/src/glareshield/drivers/nanoleaf.py
!/src/glareshield/drivers/airplay.py
!/src/glareshield/drivers/routed.py
!/examples/
/examples/*
!/examples/demo.yaml
!/scripts/
/scripts/*
!/scripts/discover.py
!/scripts/pair_lights.py
!/scripts/probe_audio.py
!/scripts/probe_simulator.py
!/scripts/setup.cmd
!/scripts/check_public.py
!/scripts/version.py
!/scripts/test_hue.py
!/scripts/test_nanoleaf.py
!/scripts/start.cmd
!/tests/
/tests/*
!/tests/test_privacy.py
!/tests/test_engine.py
!/tests/test_hue.py
!/tests/test_nanoleaf.py
!/tests/test_simulator.py
!/tests/test_audio.py
!/tests/test_keyboard.py
!/tests/test_web.py
!/tests/test_runtime.py
!/tests/test_version.py
!/docs/
/docs/*
!/docs/architecture.md
!/docs/privacy.md
!/docs/versioning.md
!/docs/discovery.md

# Private installation data must never enter Git.
/local/
/**/.env
/**/.env.*
/**/secrets.*
/**/config.yaml
/**/config.yml
/**/snapshots.json
/**/*.log
/**/*.pem
/**/*.key
/**/__pycache__/
/**/.pytest_cache/
